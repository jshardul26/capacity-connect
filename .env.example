# ==============================================================================
# CAPACITY CONNECT — ROOT ENVIRONMENT CONFIGURATION
# SIH Problem Statement ID: 26075 (MoES / IMD)
# ==============================================================================

# Project Mode: 'central' (PostgreSQL + MinIO) or 'local' (SQLite + Local FS)
APP_MODE=central
ENVIRONMENT=development
LOG_LEVEL=INFO

# Central PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=capacity_connect

# Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/capacity_connect
SQLITE_LOCAL_URL=sqlite+aiosqlite:///./data/capacity_connect_local.db

# MinIO / Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=capacity-connect-media
MINIO_SECURE=false

# Security & JWT
SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_bytes_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://capacityconnect.local"]

# Local Content Store Path (for offline Capacity Connect OS)
LOCAL_CONTENT_STORE_PATH=./data/content_store

# Station Identifier
STATION_CODE=IMD-HQ-DELHI
