[Unit]
Description=Capacity Connect kiosk session
After=capacity-connect.service graphical.target
Wants=capacity-connect.service

[Service]
User=capacityconnect
Environment=DISPLAY=:0
ExecStart=/usr/bin/xinit /usr/bin/openbox-session -- :0 vt7 -nolisten tcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
