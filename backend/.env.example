# Central vs Local Engine Mode
APP_MODE=central
ENVIRONMENT=development
LOG_LEVEL=INFO

# Central PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=capacity_connect

DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/capacity_connect
SQLITE_LOCAL_URL=sqlite+aiosqlite:///./data/capacity_connect_local.db

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=capacity-connect-media
MINIO_SECURE=false

# Security & Tokens
SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_bytes_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80"]
LOCAL_CONTENT_STORE_PATH=./data/content_store
STATION_CODE=IMD-HQ-DELHI
